@intake_bp.route('/')
@login_required
def index():
    """入荷データ一覧（旧）"""
    items = IntakeItem.query.filter(
        IntakeItem.tag_number != ''
    ).filter(
        IntakeItem.tag_number.isnot(None)
    ).order_by(IntakeItem.created_at.desc()).limit(50).all()
    return render_template('intake/index.html', items=items)


def check_missing_data_last_7days():
    """
    過去7日間でデータ未取得の日付と店舗を検出する

    Returns:
        list: 未取得のリスト [{date: date, store_code: str, store_name: str}]
    """
    from datetime import timedelta
    from sqlalchemy import func

    # 対象店舗の定義
    target_stores = [
        ('0002', 'オザム日の出店'),
        ('0006', '栄町店'),
        ('0007', 'いなげや師岡店'),
        ('0008', '牛浜店'),
        ('0011', '本社青梅店'),
        ('0012', '東青梅店'),
        ('0013', '東福生店'),
        ('0014', '狭山ヶ丘店'),
        ('0016', 'いなげや福生店'),
        ('0019', 'ﾏﾙﾌｼﾞ千ヶ瀬店'),
        ('0020', 'オザム小作店'),
        ('0021', 'コープ新町店'),
        ('0022', '所沢狭山ヶ丘店'),
        ('0024', '秋川店'),
    ]

    # 過去7日間の日付リストを生成（今日を除く）
    today = date.today()
    date_list = []
    for i in range(1, 8):  # 1日前から7日前まで
        target_date = today - timedelta(days=i)
        date_list.append(target_date)

    # データベースから取得済みの日付と店舗の組み合わせを取得
    date_from = today - timedelta(days=7)
    date_to = today - timedelta(days=1)

    target_store_codes = [code for code, name in target_stores]

    # データが存在する日付×店舗の組み合わせを取得
    existing_data = db.session.query(
        IntakeItem.store_code,
        IntakeItem.intake_date
    ).filter(
        IntakeItem.store_code.in_(target_store_codes),
        IntakeItem.intake_date >= date_from,
        IntakeItem.intake_date <= date_to,
        IntakeItem.tag_number != '',
        IntakeItem.tag_number.isnot(None)
    ).group_by(
        IntakeItem.store_code,
        IntakeItem.intake_date
    ).all()

    # 既存データをセットに変換（高速検索用）
    existing_set = set((store_code, intake_date) for store_code, intake_date in existing_data)

    # 未取得のリストを作成
    missing_list = []
    target_stores_dict = dict(target_stores)

    for target_date in date_list:
        weekday = target_date.weekday()

        for store_code, store_name in target_stores:
            # 休店日はスキップ
            if weekday == 3:  # 木曜日（全店休店日）
                continue
            if weekday == 1 and store_code in ['0013', '0016', '0020', '0024']:  # 火曜日（特定店舗）
                continue
            if weekday == 6 and store_code == '0011':  # 日曜日（本社青梅店）
                continue

            # データが存在しない場合
            if (store_code, target_date) not in existing_set:
                missing_list.append({
                    'date': target_date,
                    'store_code': store_code,
                    'store_name': store_name
                })

    return missing_list


@intake_bp.route('/list', methods=['GET', 'POST'])
@login_required
def list_items():
    """
    入荷一覧画面（ページング＋検索＋バーコード出荷対応）

    GET: 一覧表示
    POST: バーコード入力による出荷処理
    """
    # POST: バーコード出荷処理
    if request.method == 'POST':
        scanned_code = request.form.get('scanned_code', '').strip()
        highlight_tag = None

        if scanned_code:
            try:
                # モーダルで設定された包装、出荷便、担当者を取得
                wrapping = request.form.get('wrapping', '').strip() or None
                shipping_method = request.form.get('shipping_method', '').strip() or None
                operator_id_str = request.form.get('operator_id', '').strip()
                operator_id = int(operator_id_str) if operator_id_str else None

                # バーコード処理を実行
                result = process_barcode_shipment(
                    scanned_code,
                    wrapping=wrapping,
                    shipping_method=shipping_method,
                    operator_id=operator_id
                )

                if result['success']:
                    flash(result['message'], 'success')
                    # 成功した場合、該当タグの店舗で絞り込み、受付日昇順で表示
                    if 'item' in result and result['item']:
                        highlight_tag = result['item'].get_formatted_tag_number()
                        store_code = result['item'].store_code

                        # リダイレクトパラメータを設定（店舗絞り込み、受付日昇順）
                        redirect_params = {
                            'store_code': store_code,
                            'sort_by': 'intake_date',
                            'sort_order': 'asc',
                            'status': 'unshipped',  # 未出荷のみ表示
                            'highlight_tag': highlight_tag
                        }
                        return redirect(url_for('intake.list_items', **redirect_params))
                else:
                    flash(result['message'], 'warning')

            except Exception as e:
                logger.error(f"バーコード処理エラー: {e}")
                flash(f'エラーが発生しました: {str(e)}', 'error')

        # POST後はGETにリダイレクト（PRGパターン）
        # バーコード処理が成功しなかった場合は既存の検索条件を保持
        redirect_params = dict(request.args)
        if highlight_tag:
            redirect_params['highlight_tag'] = highlight_tag
        return redirect(url_for('intake.list_items', **redirect_params))

    # GET: 検索条件を取得
    store_code = request.args.get('store_code', '').strip()
    tag_number = request.args.get('tag_number', '').strip()
    date_from = request.args.get('date_from', '').strip()
    date_to = request.args.get('date_to', '').strip()
    status = request.args.get('status', 'all')  # unshipped, all
    sort_by = request.args.get('sort_by', 'intake_date')  # intake_date, tag_number
    sort_order = request.args.get('sort_order', 'asc')  # asc, desc
    page = request.args.get('page', 1, type=int)
    per_page = request.args.get('per_page', 50, type=int)

    # クエリ構築
    query = IntakeItem.query

    # タグ番号が空でないレコードのみ表示
    query = query.filter(IntakeItem.tag_number != '').filter(IntakeItem.tag_number.isnot(None))

    # 出荷ステータスフィルタ（未出荷 = status_idがshipped以外）
    if status == 'unshipped':
        shipped_status = ItemStatus.query.filter_by(status_code='shipped').first()
        if shipped_status:
            query = query.filter(IntakeItem.status_id != shipped_status.id)

    # 店舗コードフィルタ（2桁の場合は4桁に変換）
    if store_code:
        # 2桁の場合は左側に"00"を追加して4桁にする（例: "02" → "0002"）
        if len(store_code) == 2 and store_code.isdigit():
            store_code = '00' + store_code
        query = query.filter(IntakeItem.store_code == store_code)

    # タグ番号フィルタ（指定されたタグ番号以降を表示）
    if tag_number:
        # 0-000形式をデータベース形式 00-000 に変換
        # 表示: 0-123 → データベース: 00-123
        if '-' in tag_number:
            parts = tag_number.split('-')
            if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
                # 左側を2桁にパディング（例: "0" → "00"）
                left_part = parts[0].zfill(2)
                tag_search = f"{left_part}-{parts[1]}"
            else:
                tag_search = tag_number
        else:
            # ハイフンがない場合は4桁数字をX-YYY形式に変換
            if tag_number.isdigit() and len(tag_number) == 4:
                # 先頭1桁と残り3桁に分割してX-YYY形式に変換
                left_part = tag_number[0]
                right_part = tag_number[1:4]
                # 左側を2桁にパディング（例: "0" → "00"）
                left_part = left_part.zfill(2)
                tag_search = f"{left_part}-{right_part}"
            else:
                tag_search = tag_number

        # タグ番号で検索（部分一致）
        query = query.filter(IntakeItem.tag_number.like(f'%{tag_search}%'))

    # 預かり日フィルタ（from）
    if date_from:
        try:
            date_from_obj = datetime.strptime(date_from, '%Y-%m-%d').date()
            query = query.filter(IntakeItem.intake_date >= date_from_obj)
        except ValueError:
            flash('日付（from）の形式が正しくありません', 'warning')

    # 預かり日フィルタ（to）
    if date_to:
        try:
            date_to_obj = datetime.strptime(date_to, '%Y-%m-%d').date()
            query = query.filter(IntakeItem.intake_date <= date_to_obj)
        except ValueError:
            flash('日付（to）の形式が正しくありません', 'warning')

    # 並び順: sort_by と sort_order パラメータに基づいて並び替え
    if sort_by == 'tag_number':
        if sort_order == 'desc':
            query = query.order_by(IntakeItem.tag_number.desc(), IntakeItem.id.desc())
        else:
            query = query.order_by(IntakeItem.tag_number.asc(), IntakeItem.id.asc())
    else:  # デフォルトは intake_date
        if sort_order == 'desc':
            query = query.order_by(IntakeItem.intake_date.desc(), IntakeItem.id.desc())
        else:
            query = query.order_by(IntakeItem.intake_date.asc(), IntakeItem.id.asc())

    # ページネーション
    pagination = query.paginate(
        page=page,
        per_page=per_page,
        error_out=False
    )

    # 店舗一覧（検索フォーム用）
    stores = Store.query.filter_by(is_active=True).order_by(Store.store_code).all()

    # 過去7日間のデータ未取得チェック
    missing_data = check_missing_data_last_7days()

    return render_template(
        'intake/list.html',
        items=pagination.items,
        pagination=pagination,
        stores=stores,
        missing_data=missing_data,
        # 検索条件を保持
        search_params={
            'store_code': store_code,
            'tag_number': tag_number,
            'date_from': date_from,
            'date_to': date_to,
            'status': status,
            'sort_by': sort_by,
            'sort_order': sort_order,
            'per_page': per_page
        }
    )


@intake_bp.route('/list2', methods=['GET', 'POST'])
@login_required
def list_items2():
    """
    入荷一覧画面v2（2カラムレイアウト）

    GET: 一覧表示
    POST: バーコード入力または手動入力による出荷処理
    """
    # POST: バーコード出荷処理または手動入力処理
    if request.method == 'POST':
        scanned_code = request.form.get('scanned_code', '').strip()
        manual_store_code = request.form.get('manual_store_code', '').strip()
        manual_tag_number = request.form.get('manual_tag_number', '').strip()
        manual_wrapping = request.form.get('manual_wrapping', '').strip() or request.form.get('wrapping', '').strip()
        manual_shipping_method = request.form.get('manual_shipping_method', '').strip() or request.form.get('shipping_method', '').strip()
        operator_id = request.form.get('manual_operator_id', '').strip() or request.form.get('operator_id', '').strip()
        highlight_tag = None

        # Ajaxリクエストかどうかを判定
        is_ajax = request.headers.get('X-Requested-With') == 'XMLHttpRequest'

        # 手動入力の場合、バーコード形式に変換
        if manual_store_code and manual_tag_number:
            # 店舗コード（4桁）+ タグ番号（ハイフンなし4桁）の形式に変換
            # 例: 0002 + 0123 = 00020123
            tag_clean = manual_tag_number.replace('-', '')
            if len(tag_clean) == 4:
                scanned_code = manual_store_code + tag_clean
            else:
                if is_ajax:
                    return jsonify({'success': False, 'message': 'タグ番号の形式が正しくありません'}), 400
                else:
                    flash('タグ番号の形式が正しくありません', 'error')
                    return redirect(url_for('intake.list_items2', **dict(request.args)))

        if scanned_code:
            try:
                # 担当者IDを整数に変換
                operator_id_int = None
                if operator_id and operator_id.isdigit():
                    operator_id_int = int(operator_id)

                # バーコード処理を実行（包装、出荷便、担当者IDを渡す）
                result = process_barcode_shipment(
                    scanned_code,
                    wrapping=manual_wrapping or None,
                    shipping_method=manual_shipping_method or None,
                    operator_id=operator_id_int
                )

                if result['success']:
                    # Ajaxリクエストの場合はJSON形式で返す
                    if is_ajax:
                        return jsonify({
                            'success': True,
                            'message': result['message'],
                            'item': {
                                'id': result['item'].id,
                                'store_code': result['item'].store_code,
                                'tag_number': result['item'].tag_number,
                                'formatted_tag_number': result['item'].get_formatted_tag_number(),
                                'status_code': result['item'].status.status_code if result['item'].status else None,
                                'status_name': result['item'].status.status_name if result['item'].status else None,
                                'shipped_at': result['item'].shipped_at.strftime('%Y-%m-%d %H:%M') if result['item'].shipped_at else None
                            }
                        })
                    else:
                        flash(result['message'], 'success')
                        # 成功した場合、該当タグの店舗で絞り込み、受付日昇順で表示
                        if 'item' in result and result['item']:
                            highlight_tag = result['item'].get_formatted_tag_number()
                            store_code = result['item'].store_code

                            # リダイレクトパラメータを設定（店舗絞り込み、受付日昇順）
                            redirect_params = {
                                'store_code': store_code,
                                'sort_by': 'intake_date',
                                'sort_order': 'asc',
                                'status': 'unshipped',  # 未出荷のみ表示
                                'highlight_tag': highlight_tag
                            }
                            return redirect(url_for('intake.list_items2', **redirect_params))
                else:
                    if is_ajax:
                        return jsonify({'success': False, 'message': result['message']}), 400
                    else:
                        flash(result['message'], 'warning')

            except Exception as e:
                logger.error(f"バーコード処理エラー: {e}")
                if is_ajax:
                    return jsonify({'success': False, 'message': f'エラーが発生しました: {str(e)}'}), 500
                else:
                    flash(f'エラーが発生しました: {str(e)}', 'error')

        # POST後はGETにリダイレクト（PRGパターン）
        # バーコード処理が成功しなかった場合は既存の検索条件を保持
        redirect_params = dict(request.args)
        if highlight_tag:
            redirect_params['highlight_tag'] = highlight_tag
        return redirect(url_for('intake.list_items2', **redirect_params))

    # GET: 検索条件を取得
    store_code = request.args.get('store_code', '').strip()
    tag_number = request.args.get('tag_number', '').strip()
    date_from = request.args.get('date_from', '').strip()
    date_to = request.args.get('date_to', '').strip()
    status = request.args.get('status', 'all')  # unshipped, all
    shipping_method = request.args.get('shipping_method', '').strip()
    sort_by = request.args.get('sort_by', 'intake_date')  # intake_date, tag_number
    sort_order = request.args.get('sort_order', 'asc')  # asc, desc
    page = request.args.get('page', 1, type=int)
    per_page = 100  # 固定で100件表示

    # クエリ構築
    query = IntakeItem.query

    # タグ番号が空でないレコードのみ表示
    query = query.filter(IntakeItem.tag_number != '').filter(IntakeItem.tag_number.isnot(None))

    # 出荷ステータスフィルタ（未出荷 = status_idがshipped以外）
    if status == 'unshipped':
        shipped_status = ItemStatus.query.filter_by(status_code='shipped').first()
        if shipped_status:
            query = query.filter(IntakeItem.status_id != shipped_status.id)

    # 店舗コードフィルタ（2桁の場合は4桁に変換）
    if store_code:
        # 2桁の場合は左側に"00"を追加して4桁にする（例: "02" → "0002"）
        if len(store_code) == 2 and store_code.isdigit():
            store_code = '00' + store_code
        query = query.filter(IntakeItem.store_code == store_code)

    # タグ番号フィルタ（指定されたタグ番号以降を表示）
    if tag_number:
        # 0-000形式をデータベース形式 00-000 に変換
        # 表示: 0-123 → データベース: 00-123
        if '-' in tag_number:
            parts = tag_number.split('-')
            if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
                # 左側を2桁にパディング（例: "0" → "00"）
                left_part = parts[0].zfill(2)
                tag_search = f"{left_part}-{parts[1]}"
            else:
                tag_search = tag_number
        else:
            # ハイフンがない場合は4桁数字をX-YYY形式に変換
            if tag_number.isdigit() and len(tag_number) == 4:
                # 先頭1桁と残り3桁に分割してX-YYY形式に変換
                left_part = tag_number[0]
                right_part = tag_number[1:4]
                # 左側を2桁にパディング（例: "0" → "00"）
                left_part = left_part.zfill(2)
                tag_search = f"{left_part}-{right_part}"
            else:
                tag_search = tag_number

        # タグ番号で検索（部分一致）
        query = query.filter(IntakeItem.tag_number.like(f'%{tag_search}%'))

    # 預かり日フィルタ（from）
    if date_from:
        try:
            date_from_obj = datetime.strptime(date_from, '%Y-%m-%d').date()
            query = query.filter(IntakeItem.intake_date >= date_from_obj)
        except ValueError:
            flash('日付（from）の形式が正しくありません', 'warning')

    # 預かり日フィルタ（to）
    if date_to:
        try:
            date_to_obj = datetime.strptime(date_to, '%Y-%m-%d').date()
            query = query.filter(IntakeItem.intake_date <= date_to_obj)
        except ValueError:
            flash('日付（to）の形式が正しくありません', 'warning')

    # 出荷便フィルタ
    if shipping_method:
        query = query.filter(IntakeItem.shipping_method == shipping_method)

    # 並び順: sort_by と sort_order パラメータに基づいて並び替え
    if sort_by == 'tag_number':
        if sort_order == 'desc':
            query = query.order_by(IntakeItem.tag_number.desc(), IntakeItem.id.desc())
        else:
            query = query.order_by(IntakeItem.tag_number.asc(), IntakeItem.id.asc())
    else:  # デフォルトは intake_date
        if sort_order == 'desc':
            query = query.order_by(IntakeItem.intake_date.desc(), IntakeItem.id.desc())
        else:
            query = query.order_by(IntakeItem.intake_date.asc(), IntakeItem.id.asc())

    # ページネーション
    pagination = query.paginate(
        page=page,
        per_page=per_page,
        error_out=False
    )

    # 店舗一覧（検索フォーム用）
    stores = Store.query.filter_by(is_active=True).order_by(Store.store_code).all()

    # 過去7日間のデータ未取得チェック
    missing_data = check_missing_data_last_7days()

    # 出荷ログを取得（最新のみ表示）
    # 店舗コード+タグ番号の組み合わせごとに最新のログのみを取得
    from sqlalchemy import func, desc
    subquery = db.session.query(
        ShipmentLog.store_code,
        ShipmentLog.tag_number,
        func.max(ShipmentLog.scanned_at).label('max_scanned_at')
    ).filter(
        ShipmentLog.store_code.isnot(None),
        ShipmentLog.tag_number.isnot(None)
    ).group_by(
        ShipmentLog.store_code,
        ShipmentLog.tag_number
    ).subquery()

    # 最新のログを取得
    all_latest_logs = db.session.query(ShipmentLog).join(
        subquery,
        and_(
            ShipmentLog.store_code == subquery.c.store_code,
            ShipmentLog.tag_number == subquery.c.tag_number,
            ShipmentLog.scanned_at == subquery.c.max_scanned_at
        )
    ).all()

    # 同じ店舗コード+タグ番号で複数のログがある場合（同じscanned_at）、idが最大のものを選択
    latest_logs_dict = {}
    for log in all_latest_logs:
        key = f"{log.store_code or ''}|{log.tag_number or ''}"
        if key not in latest_logs_dict:
            latest_logs_dict[key] = log
        elif log.id > latest_logs_dict[key].id:
            latest_logs_dict[key] = log

    logs = sorted(latest_logs_dict.values(), key=lambda x: x.scanned_at, reverse=True)[:100]  # 最新100件のみ

    # 状態一覧（状態変更用）
    statuses = ItemStatus.query.filter_by(is_active=True).order_by(ItemStatus.display_order).all()

    return render_template(
        'intake/list2.html',
        items=pagination.items,
        pagination=pagination,
        stores=stores,
        missing_data=missing_data,
        logs=logs,
        statuses=statuses,
        # 検索条件を保持
        search_params={
            'store_code': store_code,
            'tag_number': tag_number,
            'date_from': date_from,
            'date_to': date_to,
            'status': status,
            'shipping_method': shipping_method,
            'sort_by': sort_by,
            'sort_order': sort_order,
            'per_page': per_page
        }
    )


@intake_bp.route('/list2/pdf', methods=['GET'])
@login_required
def list_items2_pdf():
    """
    出荷便ごとの納品書をPDFで生成
    
    GETパラメータ:
        shipping_method: 出荷便（必須）
    """
    shipping_method = request.args.get('shipping_method', '').strip()
    
    if not shipping_method:
        flash('出荷便が指定されていません', 'error')
        return redirect(url_for('intake.list_items2'))
    
    # reportlabが利用可能かチェック
    if not REPORTLAB_AVAILABLE:
        logger.error("reportlabがインストールされていません")
        flash('PDF生成機能を使用するにはreportlabをインストールしてください。', 'error')
        flash('インストール方法: pip install reportlab', 'info')
        return redirect(url_for('intake.list_items2'))
    
    try:
        # 出荷便でフィルタリング
        query = IntakeItem.query.filter(
            IntakeItem.shipping_method == shipping_method
        ).filter(
            IntakeItem.tag_number != ''
        ).filter(
            IntakeItem.tag_number.isnot(None)
        ).order_by(
            IntakeItem.store_code.asc(),
            IntakeItem.tag_number.asc()
        )
        
        items = query.all()
        
        if not items:
            flash(f'出荷便「{shipping_method}」に該当するデータがありません', 'warning')
            return redirect(url_for('intake.list_items2'))
        
        # PDFを生成
        try:
            buffer = BytesIO()
            doc = SimpleDocTemplate(buffer, pagesize=A4, 
                                    rightMargin=15*mm, leftMargin=15*mm,
                                    topMargin=15*mm, bottomMargin=15*mm)
            
            # 日本語フォントの登録を試行（利用可能な場合）
            japanese_font_registered = False
            try:
                import platform
                import subprocess
                system = platform.system()
                
                if system == 'Linux':
                    # Linux用のフォントパス（.ttfファイルを優先、日本語フォントを優先）
                    font_paths = [
                        # IPAフォント（日本語に最適）
                        '/usr/share/fonts/ipa-gothic-fonts/ipag.ttf',
                        '/usr/share/fonts/ipa-mincho-fonts/ipam.ttf',
                        # Notoフォント（.ttfファイル）
                        '/usr/share/fonts/google-noto-vf/NotoSans-VF.ttf',
                        # その他の一般的なパス
                        '/usr/share/fonts/truetype/ipafont-gothic/ipag.ttf',
                        '/usr/share/fonts/truetype/ipafont-mincho/ipam.ttf',
                        '/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf',
                    ]
                    
                    # 利用可能なフォントを登録（.ttfファイルのみ）
                    for font_path in font_paths:
                        if os.path.exists(font_path) and font_path.endswith('.ttf'):
                            try:
                                pdfmetrics.registerFont(TTFont('JapaneseFont', font_path))
                                japanese_font_registered = True
                                logger.info(f"日本語フォントを登録しました: {font_path}")
                                break
                            except Exception as e:
                                logger.error(f"フォント登録失敗 ({font_path}): {e}", exc_info=True)
                                continue
                
                # フォントが見つからない場合、デフォルトフォントを使用
                if not japanese_font_registered:
                    logger.warning("日本語フォントが見つかりません。日本語が正しく表示されない可能性があります。")
                    # 利用可能なフォントパスをログに出力
                    available_fonts = [p for p in font_paths if os.path.exists(p)]
                    logger.warning(f"確認したフォントパス: {available_fonts}")
            except Exception as e:
                logger.error(f"フォント登録エラー: {e}", exc_info=True)
                japanese_font_registered = False
            
            # スタイルを設定
            styles = getSampleStyleSheet()
            font_name = 'JapaneseFont' if japanese_font_registered else 'Helvetica'
            
            # フォント登録状態をログに出力
            logger.info(f"使用するフォント: {font_name} (日本語フォント登録: {japanese_font_registered})")
            
            # 日本語フォントが登録されていない場合、警告を出力
            if not japanese_font_registered:
                logger.warning("日本語フォントが登録されていません。日本語が正しく表示されない可能性があります。")
            
            title_style = ParagraphStyle(
                'CustomTitle',
                parent=styles['Heading1'],
                fontSize=18,
                textColor=colors.black,
                alignment=1,  # 中央揃え
                spaceAfter=10,
                fontName=font_name
            )
            
            normal_style = ParagraphStyle(
                'CustomNormal',
                parent=styles['Normal'],
                fontSize=8,
                fontName=font_name
            )
            
            # 小さなフォントスタイル（テーブル用）
            small_style = ParagraphStyle(
                'CustomSmall',
                parent=styles['Normal'],
                fontSize=7,
                fontName=font_name
            )
            
            # コンテンツを構築
            story = []
            
            # 発行日時
            generated_at = now_jst()
            
            # アイテムを店舗コードでグループ化
            from collections import defaultdict
            items_by_store = defaultdict(list)
            for item in items:
                store_code = item.store_code or '不明'
                items_by_store[store_code].append(item)
            
            # 店舗ごとにページを作成（店舗コードでソート）
            first_page = True
            # 店舗コードを数値としてソート（文字列の場合は自然順ソート）
            def sort_key(store_code_item):
                store_code, _ = store_code_item
                # 数値として解釈できる場合は数値でソート、できない場合は文字列でソート
                try:
                    return (0, int(store_code))
                except ValueError:
                    return (1, store_code)
            
            # タグ番号でソートする関数
            def tag_number_sort_key(item):
                """タグ番号をソート用のキーに変換"""
                tag = item.tag_number or ''
                # ハイフンで分割して数値として解釈
                if '-' in tag:
                    parts = tag.split('-')
                    if len(parts) == 2:
                        try:
                            # 左側と右側を数値として解釈
                            left = int(parts[0])
                            right = int(parts[1])
                            return (0, left, right)  # 数値としてソート
                        except ValueError:
                            return (1, tag)  # 数値に変換できない場合は文字列としてソート
                # ハイフンがない場合、数値として解釈を試みる
                try:
                    # ハイフンを除去して数値として解釈
                    tag_clean = tag.replace('-', '')
                    if tag_clean.isdigit():
                        return (0, int(tag_clean))
                except (ValueError, AttributeError):
                    pass
                return (1, tag)  # 数値に変換できない場合は文字列としてソート
            
            for store_code, store_items in sorted(items_by_store.items(), key=sort_key):
                # 各店舗のアイテムをタグ番号順にソート
                store_items = sorted(store_items, key=tag_number_sort_key)
                
                # 最初のページ以外は改ページ
                if not first_page:
                    story.append(PageBreak())
                first_page = False
                
                # 店舗情報を取得（最初のアイテムから）
                store_name = store_items[0].store_name or '-'
                store_code_display = store_code[-2:] if len(store_code) >= 2 else store_code
                
                # タイトル
                title = Paragraph(f"納品書", title_style)
                story.append(title)
                
                # 出荷便
                subtitle = Paragraph(f"出荷便: {shipping_method}", normal_style)
                story.append(subtitle)
                story.append(Spacer(1, 10*mm))
                
                # 店舗情報と納品点数
                store_info_text = f"店舗コード: {store_code_display}　　店舗名: {store_name}　　納品点数: {len(store_items)}件"
                store_info_para = Paragraph(store_info_text, normal_style)
                story.append(store_info_para)
                story.append(Spacer(1, 5*mm))
                
                # 発行日時
                info_text = f"発行日時: {generated_at.strftime('%Y年%m月%d日 %H:%M')}"
                info_para = Paragraph(info_text, normal_style)
                story.append(info_para)
                story.append(Spacer(1, 3*mm))
                
                # 1ページに150件表示するため、複数列レイアウトを使用
                # 3列レイアウト: 1列あたり50件（合計150件）
                items_per_column = 50
                num_columns = 3
                
                # データを列ごとに分割
                columns_data = []
                for col_idx in range(num_columns):
                    start_idx = col_idx * items_per_column
                    end_idx = start_idx + items_per_column
                    column_items = store_items[start_idx:end_idx]
                    columns_data.append(column_items)
                
                # 最大行数を取得（最も多い列の行数）
                max_rows = max(len(col) for col in columns_data if col) if columns_data else 0
                
                # 1つの大きなテーブルで複数列を作成
                # 行数: 最大行数 + ヘッダー行
                # 列数: 3列 × 4項目（タグ番号、商品名、包装、チェック）= 12列
                table_data = []
                
                # ヘッダー行（3列分）
                header_row = []
                for col_idx in range(num_columns):
                    header_row.extend([
                        Paragraph('タグ番号', small_style),
                        Paragraph('商品名', small_style),
                        Paragraph('包装', small_style),
                        Paragraph('チェック', small_style)
                    ])
                table_data.append(header_row)
                
                # データ行
                for row_idx in range(max_rows):
                    data_row = []
                    for col_idx in range(num_columns):
                        if col_idx < len(columns_data) and row_idx < len(columns_data[col_idx]):
                            item = columns_data[col_idx][row_idx]
                            data_row.extend([
                                Paragraph(item.get_formatted_tag_number(), small_style),
                                Paragraph(item.product_name or '-', small_style),
                                Paragraph(item.wrapping or '-', small_style),
                                Paragraph('', small_style)  # チェック欄（空白）
                            ])
                        else:
                            # 空のセル
                            data_row.extend([
                                Paragraph('', small_style),
                                Paragraph('', small_style),
                                Paragraph('', small_style),
                                Paragraph('', small_style)  # チェック欄（空白）
                            ])
                    table_data.append(data_row)
                
                # テーブルを作成
                available_width = 180 * mm  # A4幅 - 左右マージン
                column_group_width = available_width / num_columns
                # 各列グループ内の列幅: タグ番号 20mm、商品名 残り、包装 15mm、チェック 8mm
                tag_width = 20 * mm
                wrapping_width = 15 * mm
                check_width = 8 * mm
                product_width = column_group_width - tag_width - wrapping_width - check_width
                
                # 全列の列幅を設定
                col_widths = []
                for _ in range(num_columns):
                    col_widths.extend([tag_width, product_width, wrapping_width, check_width])
                
                table = Table(table_data, colWidths=col_widths)
                
                # テーブルスタイル
                table.setStyle(TableStyle([
                    # ヘッダー行のスタイル
                    ('BACKGROUND', (0, 0), (-1, 0), colors.grey),
                    ('TEXTCOLOR', (0, 0), (-1, 0), colors.whitesmoke),
                    ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
                    ('FONTSIZE', (0, 0), (-1, 0), 7),
                    ('BOTTOMPADDING', (0, 0), (-1, 0), 3),
                    ('TOPPADDING', (0, 0), (-1, 0), 3),
                    # データ行のスタイル
                    ('BACKGROUND', (0, 1), (-1, -1), colors.beige),
                    ('GRID', (0, 0), (-1, -1), 0.5, colors.black),
                    ('FONTSIZE', (0, 1), (-1, -1), 6),
                    ('VALIGN', (0, 0), (-1, -1), 'MIDDLE'),
                    ('LEFTPADDING', (0, 0), (-1, -1), 2),
                    ('RIGHTPADDING', (0, 0), (-1, -1), 2),
                    ('TOPPADDING', (0, 1), (-1, -1), 1),
                    ('BOTTOMPADDING', (0, 1), (-1, -1), 1),
                    # 列ごとの配置
                    # タグ番号列（0, 4, 8...）は中央揃え
                    ('ALIGN', (0, 0), (0, -1), 'CENTER'),
                    ('ALIGN', (4, 0), (4, -1), 'CENTER'),
                    ('ALIGN', (8, 0), (8, -1), 'CENTER'),
                    # 商品名列（1, 5, 9...）は左揃え
                    ('ALIGN', (1, 0), (1, -1), 'LEFT'),
                    ('ALIGN', (5, 0), (5, -1), 'LEFT'),
                    ('ALIGN', (9, 0), (9, -1), 'LEFT'),
                    # 包装列（2, 6, 10...）は中央揃え
                    ('ALIGN', (2, 0), (2, -1), 'CENTER'),
                    ('ALIGN', (6, 0), (6, -1), 'CENTER'),
                    ('ALIGN', (10, 0), (10, -1), 'CENTER'),
                    # チェック列（3, 7, 11...）は中央揃え
                    ('ALIGN', (3, 0), (3, -1), 'CENTER'),
                    ('ALIGN', (7, 0), (7, -1), 'CENTER'),
                    ('ALIGN', (11, 0), (11, -1), 'CENTER'),
                    # 列間の区切り線を強調（各列グループの最後の列の後）
                    ('LINEAFTER', (3, 0), (3, -1), 1, colors.black),
                    ('LINEAFTER', (7, 0), (7, -1), 1, colors.black),
                ]))
                
                story.append(table)
                
                # フッター
                story.append(Spacer(1, 10*mm))
                footer_text = f"発行日時: {generated_at.strftime('%Y年%m月%d日 %H:%M:%S')}"
                footer_para = Paragraph(footer_text, normal_style)
                story.append(footer_para)
            
            # PDFを構築
            doc.build(story)
            
            # レスポンスを作成
            pdf = buffer.getvalue()
            buffer.close()
            
            response = make_response(pdf)
            response.headers['Content-Type'] = 'application/pdf'
            # ファイル名をURLエンコードして設定（日本語対応）
            from urllib.parse import quote
            filename = f'納品書_{shipping_method}_{datetime.now().strftime("%Y%m%d")}.pdf'
            response.headers['Content-Disposition'] = f'inline; filename="{quote(filename)}"; filename*=UTF-8\'\'{quote(filename)}'
            
            logger.info(f"PDF生成成功: 出荷便={shipping_method}, 件数={len(items)}")
            return response
        except Exception as e:
            logger.error(f"PDF生成エラー: {e}", exc_info=True)
            import traceback
            error_detail = traceback.format_exc()
            logger.error(f"PDF生成エラー詳細:\n{error_detail}")
            # エラーレスポンスを返す（リダイレクトではなく）
            error_msg = f'PDF生成中にエラーが発生しました: {str(e)}'
            return make_response(error_msg, 500)
    except Exception as e:
        logger.error(f"予期しないエラー: {e}", exc_info=True)
        import traceback
        error_detail = traceback.format_exc()
        logger.error(f"予期しないエラー詳細:\n{error_detail}")
        # エラーレスポンスを返す（リダイレクトではなく）
        error_msg = f'エラーが発生しました: {str(e)}'
        return make_response(error_msg, 500)



def process_barcode_shipment(scanned_code: str, wrapping: str = None, shipping_method: str = None, operator_id: int = None) -> dict:
    """
    バーコードから出荷処理を実行する

    Args:
        scanned_code (str): 9桁のバーコード
        wrapping (str): 包装（オプション）
        shipping_method (str): 出荷便（オプション）
        operator_id (int): 担当者ID（オプション）

    Returns:
        dict: {'success': bool, 'message': str}
    """
    # 入力された生のコードを保存（エラー表示用）
    original_input = scanned_code

    # 全角数字を半角数字に変換
    scanned_code = scanned_code.translate(str.maketrans('０１２３４５６７８９', '0123456789'))

    try:
        # バーコードから店舗コードとタグ番号を抽出
        store_code, tag_number = parse_tag_barcode(scanned_code)

    except ValueError as e:
        logger.warning(f"バーコードパースエラー: 入力={original_input}, 変換後={scanned_code} - {e}")
        return {
            'success': False,
            'message': f'バーコードの形式が正しくありません。入力されたコード: 「{original_input}」（半角変換後: 「{scanned_code}」） - {str(e)}'
        }

    # 店舗コードを4桁に変換（バーコードは3桁、DBは4桁）
    # 3桁の場合は左側に"0"を追加して4桁にする（例: "024" → "0024"）
    if len(store_code) == 3 and store_code.isdigit():
        store_code = '0' + store_code
    # 2桁の場合は左側に"00"を追加して4桁にする（例: "02" → "0002"）
    elif len(store_code) == 2 and store_code.isdigit():
        store_code = '00' + store_code

    # 店舗を検索
    store = Store.query.filter_by(store_code=store_code).first()
    if not store:
        logger.warning(f"店舗が見つかりません: 入力={original_input}, 店舗コード={store_code}")
        return {
            'success': False,
            'message': f'該当する店舗が見つかりません。入力されたコード: 「{original_input}」（店舗コード: {store_code}）'
        }

    # タグ番号を複数の形式に正規化して検索
    tag_search_patterns = normalize_tag_number_for_search(tag_number)

    # 出荷済み状態を取得
    shipped_status = ItemStatus.query.filter_by(status_code='shipped').first()
    if not shipped_status:
        logger.error(f"出荷済み状態が見つかりません: 入力={original_input}")
        return {
            'success': False,
            'message': f'出荷済み状態が見つかりません。データベースの初期設定を確認してください。（入力: 「{original_input}」）'
        }

    # 未出荷の入荷データを検索（status_idが出荷済み以外）
    intake_item = None
    for pattern in tag_search_patterns:
        intake_item = IntakeItem.query.filter(
            and_(
                IntakeItem.store_id == store.id,
                IntakeItem.tag_number == pattern,
                IntakeItem.status_id != shipped_status.id
            )
        ).first()
        if intake_item:
            logger.debug(f"タグ番号マッチ: 検索パターン={pattern}, DB値={intake_item.tag_number}")
            break

    if not intake_item:
        # 該当データなし
        logger.warning(f"該当する入荷データが見つかりません: 入力={original_input}, 店舗={store_code}, タグ={tag_number}")

        # 既に出荷済みかチェック（複数の形式で検索）
        shipped_item = None
        for pattern in tag_search_patterns:
            shipped_item = IntakeItem.query.filter(
                and_(
                    IntakeItem.store_id == store.id,
                    IntakeItem.tag_number == pattern,
                    IntakeItem.status_id == shipped_status.id
                )
            ).first()
            if shipped_item:
                break

        if shipped_item:
            return {
                'success': False,
                'message': f'このタグは既に出荷済みです。入力されたコード: 「{original_input}」（店舗: {store_code} / タグ: {tag_number}）'
            }
        else:
            return {
                'success': False,
                'message': f'該当する入荷データが見つかりません。入力されたコード: 「{original_input}」（店舗: {store_code} / タグ: {tag_number}）'
            }

    # トランザクション開始
    try:
        # 出荷処理
        now = now_jst()
        intake_item.shipped_at = now
        intake_item.status_id = shipped_status.id  # 状態を更新

        # 包装、出荷便、担当者を保存（手動入力から渡された場合）
        if wrapping:
            intake_item.wrapping = wrapping
        if shipping_method:
            intake_item.shipping_method = shipping_method
        if operator_id:
            intake_item.operator_id = operator_id

        # 履歴番号を取得
        history_number = get_next_history_number(
            intake_item.store_code,
            intake_item.intake_date,
            intake_item.tag_number
        )

        # 出荷ログを作成（状態変更履歴）
        shipment_log = ShipmentLog(
            intake_item_id=intake_item.id,
            store_id=store.id,
            store_code=intake_item.store_code,  # 複合キー
            intake_date=intake_item.intake_date,  # 複合キー
            tag_number=intake_item.tag_number,  # 複合キー
            history_number=history_number,  # 履歴番号
            scanned_code=scanned_code,
            scanned_at=now,
            scanned_by_user_id=current_user.id if current_user.is_authenticated else None,
            operator_id=operator_id,  # 担当者IDを保存
            status='completed',
            new_status_id=shipped_status.id  # 変更後の状態
        )
        db.session.add(shipment_log)

        db.session.commit()

        logger.info(f"出荷完了: {store_code}/{tag_number} - {intake_item.customer_name}")

        # WebSocketで他のクライアントに更新を通知
        socketio.emit('shipment_updated', {
            'item_id': intake_item.id,
            'store_code': intake_item.store_code,
            'tag_number': intake_item.tag_number,
            'formatted_tag_number': intake_item.get_formatted_tag_number(),
            'status_id': intake_item.status_id,
            'status_code': intake_item.status.status_code if intake_item.status else None,
            'status_name': intake_item.status.status_name if intake_item.status else None,
            'product_name': intake_item.product_name,
            'wrapping': intake_item.wrapping,
            'shipping_method': intake_item.shipping_method,
            'intake_date': intake_item.intake_date.strftime('%Y-%m-%d') if intake_item.intake_date else None,
            'shipped_at': intake_item.shipped_at.strftime('%Y-%m-%d %H:%M:%S') if intake_item.shipped_at else None,
            'shipped_at_short': intake_item.shipped_at.strftime('%Y-%m-%d %H:%M') if intake_item.shipped_at else None
        })

        return {
            'success': True,
            'message': (
                f'出荷完了： 店舗 {store_code} / タグ {tag_number} / '
                f'受付日 {intake_item.intake_date.strftime("%Y-%m-%d") if intake_item.intake_date else "（不明）"} / '
                f'商品 {intake_item.product_name or "（不明）"}'
            ),
            'item': intake_item
        }

    except Exception as e:
        db.session.rollback()
        logger.error(f"出荷処理中にエラー: {e}")
        raise


@intake_bp.route('/upload', methods=['GET', 'POST'])
@login_required
def upload():
    """CSV ファイルアップロード"""
    if request.method == 'POST':
        # 日付指定の取り込みかどうかをチェック
        import_date = request.form.get('import_date', '').strip()
        if import_date:
            # 日付指定の取り込み
            try:
                from datetime import datetime
                from pathlib import Path
                from factory_shipping.intake.services import import_hanjow_csv
                
                # 日付をパース
                dt = datetime.strptime(import_date, '%Y-%m-%d')
                date_str = dt.strftime('%Y%m%d')
                
                # ファイルパスを生成
                csv_dir = Path('/var/www/html/king-req/downloads_hanjow')
                csv_file = csv_dir / f'hanjow_{date_str}.csv'
                
                # ファイル存在チェック
                if not csv_file.exists():
                    flash(f'指定された日付のCSVファイルが見つかりません: {csv_file}', 'error')
                    return redirect(url_for('intake.upload'))
                
                # CSV 取り込み処理
                result = import_hanjow_csv(str(csv_file))
                
                # 成功メッセージ
                flash(
                    f'CSV ファイルの取り込みが完了しました（{import_date}）。'
                    f'新規作成: {result["created"]}件, '
                    f'スキップ: {result["skipped"]}件, '
                    f'エラー: {result["errors"]}件',
                    'success' if result['errors'] == 0 else 'warning'
                )
                
                return redirect(url_for('intake.list_items'))
                
            except ValueError as e:
                flash(f'日付の形式が正しくありません: {import_date} (YYYY-MM-DD形式)', 'error')
                return redirect(url_for('intake.upload'))
            except Exception as e:
                logger.error(f"日付指定CSV取り込みエラー: {e}")
                flash(f'CSV ファイルの取り込み中にエラーが発生しました: {str(e)}', 'error')
                return redirect(url_for('intake.upload'))
        
        # ファイルアップロード処理
        # ファイルがアップロードされているかチェック
        if 'csv_file' not in request.files:
            flash('ファイルが選択されていません', 'error')
            return redirect(url_for('intake.upload'))

        file = request.files['csv_file']

        # ファイル名が空でないかチェック
        if file.filename == '':
            flash('ファイルが選択されていません', 'error')
            return redirect(url_for('intake.upload'))

        # ファイル拡張子チェック
        if not file.filename.lower().endswith('.csv'):
            flash('CSV ファイルのみアップロード可能です', 'error')
            return redirect(url_for('intake.upload'))

        try:
            # アップロードフォルダのパスを取得
            upload_folder = current_app.config['UPLOAD_FOLDER']
            os.makedirs(upload_folder, exist_ok=True)

            # 安全なファイル名を生成
            filename = secure_filename(file.filename)
            timestamp = now_jst().strftime('%Y%m%d_%H%M%S')
            filepath = os.path.join(upload_folder, f'{timestamp}_{filename}')

            # ファイルを保存
            file.save(filepath)

            # CSV 取り込み処理
            result = import_hanjow_csv(filepath)

            # 成功メッセージ
            flash(
                f'CSV ファイルの取り込みが完了しました。'
                f'新規作成: {result["created"]}件, '
                f'スキップ: {result["skipped"]}件, '
                f'エラー: {result["errors"]}件',
                'success' if result['errors'] == 0 else 'warning'
            )

            # 一時ファイルを削除（オプション）
            # os.remove(filepath)

            return redirect(url_for('intake.list_items'))

        except FileNotFoundError as e:
            logger.error(f"ファイルが見つかりません: {e}")
            flash(f'エラー: {str(e)}', 'error')
            return redirect(url_for('intake.upload'))

        except Exception as e:
            logger.error(f"CSV 取り込みエラー: {e}")
            flash(f'CSV ファイルの取り込み中にエラーが発生しました: {str(e)}', 'error')
            return redirect(url_for('intake.upload'))

    return render_template('intake/upload.html')


@intake_bp.route('/toggle-shipment/<int:item_id>', methods=['POST'])
@login_required
def toggle_shipment(item_id):
    """出荷状態をトグル（未出荷 ↔ 出荷済み）"""
    item = IntakeItem.query.get_or_404(item_id)

    try:
        now = now_jst()

        # 出荷済み状態を取得
        shipped_status = ItemStatus.query.filter_by(status_code='shipped').first()
        received_status = ItemStatus.query.filter_by(status_code='received').first()

        if not shipped_status or not received_status:
            flash('状態マスタの初期設定を確認してください', 'error')
            return redirect(url_for('intake.list'))

        # セッションから担当者を取得
        from flask import session
        operator_id = session.get('operator_id')

        if item.status_id == shipped_status.id:
            # 出荷済み → 入荷に戻す
            item.status_id = received_status.id
            item.shipped_at = now

            # 履歴番号を取得
            history_number = get_next_history_number(
                item.store_code,
                item.intake_date,
                item.tag_number
            )

            # 状態変更ログを作成
            shipment_log = ShipmentLog(
                intake_item_id=item.id,
                store_id=item.store_id,
                store_code=item.store_code,  # 複合キー
                intake_date=item.intake_date,  # 複合キー
                tag_number=item.tag_number,  # 複合キー
                history_number=history_number,  # 履歴番号
                scanned_code=None,
                scanned_at=now,
                scanned_by_user_id=current_user.id if current_user.is_authenticated else None,
                operator_id=operator_id,  # セッションから取得した担当者ID
                status='completed',
                new_status_id=received_status.id,
                notes='手動で入荷状態に変更'
            )
            db.session.add(shipment_log)

            message = f'状態を「入荷」に変更しました（店舗: {item.store_code} / タグ: {item.tag_number}）'
            logger.info(f"状態を入荷に変更: {item.store_code}/{item.tag_number} by {current_user.username}")
        else:
            # 未出荷 → 出荷済みにする
            item.status_id = shipped_status.id
            item.shipped_at = now

            # 履歴番号を取得
            history_number = get_next_history_number(
                item.store_code,
                item.intake_date,
                item.tag_number
            )

            # 出荷ログを作成
            shipment_log = ShipmentLog(
                intake_item_id=item.id,
                store_id=item.store_id,
                store_code=item.store_code,  # 複合キー
                intake_date=item.intake_date,  # 複合キー
                tag_number=item.tag_number,  # 複合キー
                history_number=history_number,  # 履歴番号
                scanned_code=None,
                scanned_at=now,
                scanned_by_user_id=current_user.id if current_user.is_authenticated else None,
                operator_id=operator_id,  # セッションから取得した担当者ID
                status='completed',
                new_status_id=shipped_status.id,
                notes='手動で出荷済みに変更'
            )
            db.session.add(shipment_log)

            message = f'状態を「出荷済み」に変更しました（店舗: {item.store_code} / タグ: {item.tag_number}）'
            logger.info(f"状態を出荷済みに変更: {item.store_code}/{item.tag_number} by {current_user.username}")

        db.session.commit()

        # WebSocketで他のクライアントに更新を通知
        socketio.emit('shipment_updated', {
            'item_id': item.id,
            'store_code': item.store_code,
            'tag_number': item.tag_number,
            'status_id': item.status_id,
            'status_code': item.status.status_code if item.status else None,
            'status_name': item.status.status_name if item.status else None,
            'shipped_at': item.shipped_at.strftime('%Y-%m-%d %H:%M:%S') if item.shipped_at else None
        })

        # JSONレスポンスを返す（AJAX用）
        from flask import jsonify
        return jsonify({
            'success': True,
            'message': message,
            'status_id': item.status_id,
            'status_code': item.status.status_code if item.status else None,
            'status_name': item.status.status_name if item.status else None,
            'shipped_at': item.shipped_at.strftime('%Y-%m-%d %H:%M') if item.shipped_at else None
        })
        
    except Exception as e:
        db.session.rollback()
        logger.error(f"出荷状態変更エラー: {e}")
        from flask import jsonify
        return jsonify({
            'success': False,
            'message': f'エラーが発生しました: {str(e)}'
        }), 500


@intake_bp.route('/detail/<int:item_id>')
