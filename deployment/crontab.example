# ========================================
# 新・出荷システム - cron設定例
# ========================================
#
# この設定を crontab に追加する方法:
#   crontab -e
#
# または、システム全体で設定する場合:
#   sudo cp deployment/factory-shipping.cron /etc/cron.d/factory-shipping
#   sudo chmod 644 /etc/cron.d/factory-shipping
#
# ========================================

# 環境変数
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=""

# ========================================
# hanjow CSV 自動取り込み
# ========================================

# 毎日 22:35 に今日の CSV を自動取り込み
# CSVファイルは 22:30 に配置されることを想定
35 22 * * * /var/www/html/factory-intake-shipping/scripts/auto_import_hanjow.sh >> /var/log/factory-shipping/auto-import.log 2>&1

# ========================================
# ログローテーション (オプション)
# ========================================

# 毎週日曜日の深夜1時にログをアーカイブ（過去30日分を保持）
# 0 1 * * 0 find /var/log/factory-shipping -name "*.log" -type f -mtime +30 -exec gzip {} \;

# ========================================
# バックアップ (オプション)
# ========================================

# 毎日深夜2時にデータベースをバックアップ
# 0 2 * * * /var/www/html/factory-intake-shipping/scripts/backup_database.sh >> /var/log/factory-shipping/backup.log 2>&1
