# 新・出荷システム - 環境変数テンプレート
# このファイルを .env にコピーして、各値を環境に合わせて編集してください
# cp .env.example .env

# ===============================================
# Flask 環境設定
# ===============================================

# 環境モード: development, production, testing
FLASK_ENV=development

# Flask アプリケーション名（run.py で使用）
FLASK_APP=run.py

# デバッグモード（本番環境では必ず False）
FLASK_DEBUG=True

# シークレットキー（本番環境では必ず変更すること！）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# ===============================================
# データベース接続
# ===============================================

# MySQL/MariaDB 接続文字列
# 形式: mysql+pymysql://[ユーザー名]:[パスワード]@[ホスト]:[ポート]/[データベース名]?charset=utf8mb4
DATABASE_URL=mysql+pymysql://factory_user:factory_password@localhost:3306/factory_shipping?charset=utf8mb4

# データベース接続情報（個別指定の場合）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=factory_shipping
DB_USER=factory_user
DB_PASSWORD=factory_password

# ===============================================
# アプリケーション設定
# ===============================================

# アプリケーションURL（本番環境）
APP_URL=http://localhost:5000

# アップロードファイル保存先
UPLOAD_FOLDER=/var/www/html/factory-intake-shipping/uploads

# ログレベル（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=DEBUG

# ===============================================
# Gunicorn 設定（本番環境用）
# ===============================================

# ワーカー数（推奨: CPU コア数 × 2 + 1）
GUNICORN_WORKERS=4

# バインドアドレス
GUNICORN_BIND=unix:/var/www/html/factory-intake-shipping/gunicorn.sock

# タイムアウト（秒）
GUNICORN_TIMEOUT=120

# ===============================================
# その他
# ===============================================

# タイムゾーン
TIMEZONE=Asia/Tokyo

# セッションタイムアウト（時間）
SESSION_LIFETIME_HOURS=8
